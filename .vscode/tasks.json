{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Lab Results",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "http.server",
        "8000",
        "--bind",
        "0.0.0.0",
        "--directory",
        "${workspaceFolder}/.devcontainer/lab-output"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
