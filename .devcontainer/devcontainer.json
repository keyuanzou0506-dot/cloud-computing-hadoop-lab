{
  "name": "Hadoop HDFS Teaching Lab",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "hadoop",
  "containerUser": "hadoop",
  "postCreateCommand": "bash scripts/setup-hadoop.sh && bash .devcontainer/run-lab.sh",
  "postStartCommand": "nohup bash -c 'while true; do python3 -m http.server 8000 --directory \"$PWD/.devcontainer/lab-output\"; sleep 1; done' >/tmp/lab-http.log 2>&1 &",
  "forwardPorts": [
    9870,
    8000
  ],
  "portsAttributes": {
    "9870": {
      "label": "HDFS NameNode Web UI",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Lab Results",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.browser.enableRemoteProxy": true,
        "workbench.browser.showInTitleBar": true
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  }
}
